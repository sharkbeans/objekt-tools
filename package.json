{
  "name": "objekt-trade",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node",
    "test:node": "tsx --test --test-concurrency=1 'src/**/*.test.ts'",
    "test:node:watch": "tsx --test --watch --test-concurrency=1 'src/**/*.test.ts'",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "sync-indexer": "tsx scripts/sync-indexer.ts",
    "extension:build": "node extensions/discord-capture/build.mjs",
    "extension:test": "tsx --test extensions/discord-capture/src/*.test.ts",
    "extension:smoke": "NEXT_PUBLIC_APP_URL= EXTENSION_MATCH_URL=https://objekt.my npm run extension:build && node extensions/discord-capture/smoke.mjs",
    "extension:build:firefox": "node extensions/discord-capture/build.mjs --firefox",
    "extension:package": "node extensions/discord-capture/pack.mjs",
    "extension:source-archive": "node extensions/discord-capture/source-archive.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.25",
    "@better-auth/drizzle-adapter": "1.7.25",
    "@tanstack/react-query": "^5.107.1",
    "@types/web-push": "^3.6.4",
    "better-auth": "1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "gifuct-js": "^2.1.2",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.73.0",
    "nanoid": "^5.1.6",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "ofetch": "^1.5.1",
    "omggif": "^1.0.10",
    "pg": "^8.23.1",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "form-data": "4.0.6",
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    },
    "@ts-morph/common": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.2.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/omggif": "^1.0.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^27.0.1",
    "msw": "^2.15.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
